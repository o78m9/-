# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Admin (server-only — required by scripts/backfill-clinic-app-metadata.mjs)
# NEVER expose to client. Used by Action #2 backfill + future admin tasks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Neon Database (optional — for real customer data)
DATABASE_URL=postgresql://...

# Demo clinic ID (optional — loads real data without auth in dev)
NEXT_PUBLIC_DEMO_CLINIC_ID=

# RTA-001 — HMAC secret for the demo bypass cookie.
# Required in production. Generate with: openssl rand -hex 32
COOKIE_SIGNING_SECRET=

# RTA-002 — fallback cutover for user_metadata.clinic_id reads.
# After this ISO date, the requireClinic() helper returns 403 for users
# whose clinic_id was not migrated to app_metadata. Set to 7 days after
# the Action #2 backfill apply.
CLINIC_METADATA_FALLBACK_UNTIL=

# RTA-008 — only enable on platforms where the immediate upstream is a
# trusted proxy that strips client-set x-forwarded-for. Vercel sets
# x-vercel-forwarded-for which is always trusted; do NOT set this flag
# unless you operate the proxy yourself.
TRUST_X_FORWARDED_FOR=

# RTA-004 — cron secret (already required by /api/cron/prune-audit).
CRON_SECRET=

# Optional CSRF allowlist (comma-separated).
ALLOWED_ORIGINS=

# Optional Upstash for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
