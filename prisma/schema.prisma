generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Clinic {
  id        String     @id @default(uuid())
  name      String
  owner     String?
  phone     String?
  createdAt DateTime   @default(now()) @map("created_at")
  customers Customer[]

  @@map("clinics")
}

model Customer {
  id         String    @id @default(uuid())
  clinicId   String?   @map("clinic_id")
  name       String
  phone      String
  email      String?
  firstVisit DateTime? @map("first_visit") @db.Date
  lastVisit  DateTime? @map("last_visit") @db.Date
  totalSpent Decimal   @default(0) @map("total_spent")
  status     String    @default("active")
  tags       String[]
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  clinic     Clinic?   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  visits     Visit[]

  @@unique([phone, clinicId], name: "customers_phone_clinic_unique")
  @@index([clinicId])
  @@index([status])
  @@index([lastVisit])
  @@map("customers")
}

model Visit {
  id         String    @id @default(uuid())
  customerId String?   @map("customer_id")
  date       DateTime  @db.Date
  service    String?
  amount     Decimal?
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("visits")
}

/// PDPL-compliant audit trail. 12-month retention enforced via scheduled prune job.
/// `metadata` is opaque JSON — never store secrets, tokens, or full PII payloads here.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  clinicId   String?  @map("clinic_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ip         String?
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([clinicId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

